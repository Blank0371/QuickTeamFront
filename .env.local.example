# Kopieren nach .env.local und ausfüllen.
# Autorisierung macht RLS, also reicht überall der anon-Key. Die einzige
# Ausnahme steht ganz unten und ist dort begründet.

# ======================================================================
#  NICHT die Produktionskonfiguration hierher kopieren.
# ======================================================================
#
# Am 2026-09-14 lag im Arbeitsverzeichnis eine `.env.local`, die byteweise
# identisch mit `.env.production` war — Produktions-Supabase,
# Service-Role-Key, Live-Stripe-Werte. Ein Umbenennen macht daraus keine
# Testumgebung: der Zahlungsweg legt Kunden, Abos und Zahlungsmethoden an,
# und der Webhook schreibt in `betrieb_abonnements`. Beides wären dann
# echte Daten echter Betriebe.
#
# Eine Testumgebung braucht **beide** Seiten eigen:
#   * ein eigenes Supabase-Projekt mit dem QuickTeam-Schema
#     (die Sandbox-BETRIEBE liegen in der Produktionsinstanz und
#      genügen dafür nicht),
#   * Stripe-Testschlüssel (sk_test_/pk_test_) mit eigenen Testpreisen,
#   * einen Webhook für genau diese Umgebung (`stripe listen`).
#
# Vor den integrierten Zahlungstests prüfen — das Skript gibt keine Werte
# aus und endet mit Exitcode 1, wenn etwas nicht passt:
#
#     node --env-file=.env.local scripts/pruefe-testumgebung.mjs
#
# Ablauf und Fälle: docs/zahlung-testprotokoll.md
# ======================================================================

# --- Soft-Launch-Schalter ---------------------------------------------
# Steuert beides: welche Routen ausgeliefert werden (/login, /registrieren,
# /passwort-vergessen, /einrichtung) UND ob es sichtbare Knöpfe dorthin
# gibt. Siehe CLAUDE.md, Abschnitt „Der Soft-Launch-Schalter".
#
# Der Schalter ist DEFAULT-GESCHLOSSEN: gelesen wird
# `SOFT_LAUNCH?.trim().toLowerCase() !== "aus"`, ein fehlender, leerer oder
# vertippter Wert lässt die Sperre also zu. Das ist für eine Sperre gegen
# Kontoanlage und Zahlung die richtige Richtung — kostet aber lokal genau
# das, was hier schon einmal passiert ist: ohne diese Zeile startet die
# Seite ohne „Anmelden" und ohne „Kostenlos testen", und /registrieren
# antwortet mit einer Weiterleitung auf /.
#
#   lokal und Staging -> aus
#   Produktion        -> an   (in der Vercel-Umgebung setzen, nicht hier)
SOFT_LAUNCH=aus

NEXT_PUBLIC_SUPABASE_URL=https://jqpfuotwsgnqihspsmmf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Ziel der Weiterleitung nach Login und nach bestätigter Registrierung:
# die separate Planungs-App. Das ist eine native Expo-App — für einen Browser
# gibt es dort nur im Entwicklungsbetrieb etwas zu sehen. Lokal läuft sie über
# `npm run web` im App-Repo, standardmässig auf Port 8081.
NEXT_PUBLIC_APP_URL=http://localhost:8081

# Optional. Adresse für Custom-Anfragen auf /preise. Ohne Wert steht dort
# „Kontaktadresse folgt in Kürze" statt eines toten mailto-Links.
NEXT_PUBLIC_KONTAKT_EMAIL=

# Optional. Basis für metadataBase, Sitemap, robots.txt und JSON-LD.
# Ohne Wert wird https://quickteam.at angenommen.
NEXT_PUBLIC_SITE_URL=

# --- Stripe -----------------------------------------------------------
# Alles hier ist serverseitig. Kein NEXT_PUBLIC_-Präfix, sonst landen die
# Werte im Browser-Bundle.

# Der einzige Stripe-Wert, der in den Browser darf: das Payment Element
# in Schritt 2 und auf der Sperrseite spricht damit mit Stripe.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

STRIPE_SECRET_KEY=

# Liefert die Stripe CLI beim Start von
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
# Für die bereitgestellte Umgebung steht der Wert stattdessen im
# Stripe-Dashboard unter Developers → Webhooks.
STRIPE_WEBHOOK_SECRET=

# Eine Price-ID je Plan. Nie als Literal in den Code — fehlt eine, meldet
# sich der Checkout mit einem Konfigurationsfehler statt still auf einen
# anderen Plan auszuweichen.
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# --- Ausnahme, siehe CLAUDE.md ----------------------------------------
# Der service_role-Key wird an genau einer Stelle gelesen:
# src/app/api/stripe/webhook/route.ts. Grund: betrieb_abonnements hat
# ausschliesslich eine SELECT-Policy, der Zahlungsstatus wäre sonst nicht
# speicherbar. Niemals mit NEXT_PUBLIC_-Präfix, niemals in einer zweiten
# Datei.
SUPABASE_SERVICE_ROLE_KEY=
